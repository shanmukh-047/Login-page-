# Copy to your environment (or a process manager / hosting dashboard). Never commit real values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=www.protolearn.org,protolearn.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.protolearn.org,https://protolearn.org

# Database: leave DB_ENGINE empty to use SQLite (db.sqlite3 next to manage.py).
# To point at your existing PostgreSQL database instead:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=protolearn
# DB_USER=protolearn
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Where users land after a successful login (paths on your site).
PROTOLEARN_DEFAULT_REDIRECT=/login
PROTOLEARN_STAFF_REDIRECT=/manage/
